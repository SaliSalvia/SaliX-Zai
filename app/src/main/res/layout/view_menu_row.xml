<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/menu_row_bg"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp">

        <ImageView
            android:id="@+id/menuIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            tools:src="@drawable/ic_refresh" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/menuTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/dark_on_surface"
                android:textSize="14sp"
                tools:text="بازآوری صفحه" />

            <TextView
                android:id="@+id/menuSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/dark_on_surface_variant"
                android:textSize="11sp"
                tools:text="بارگذاری دوباره chat.z.ai" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/menuDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="58dp"
        android:background="#12FFFFFF" />
</LinearLayout>
