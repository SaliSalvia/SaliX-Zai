<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Main theme (post-splash): dark, AppCompat-based, Sali-ZZ colors -->
    <style name="Theme.SaliX" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:navigationBarColor">@color/dark_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:colorAccent">@color/purple_primary</item>
        <item name="colorAccent">@color/purple_primary</item>
        <item name="android:colorPrimary">@color/purple_primary</item>
        <item name="android:colorControlActivated">@color/purple_primary</item>
        <item name="android:textColor">@color/dark_on_surface</item>
        <item name="android:textColorPrimary">@color/dark_on_surface</item>
        <item name="android:textColorSecondary">@color/dark_on_surface_variant</item>
    </style>

    <!-- System splash, identical hand-off to Sali-ZZ: plain color + logo -->
    <style name="Theme.SaliX.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.SaliX</item>
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <!-- Popup menu on dark surface -->
    <style name="Theme.SaliX.Popup" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/popup_bg</item>
        <item name="android:textColor">@color/dark_on_surface</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Bottom-sheet dialog used for the shell menu -->
    <style name="Theme.SaliX.Sheet" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowAnimationStyle">@style/Animation.SaliX.Sheet</item>
    </style>

    <style name="Animation.SaliX.Sheet" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>

    <!-- Preview action chips -->
    <style name="Widget.SaliX.Chip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableTint">@color/purple_light</item>
        <item name="android:textColor">@color/dark_on_surface</item>
        <item name="android:textSize">12sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.SaliX.Chip.Primary" parent="Widget.SaliX.Chip">
        <item name="android:background">@drawable/chip_bg_primary</item>
        <item name="android:drawableTint">@color/dark_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
